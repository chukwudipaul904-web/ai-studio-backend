const express = require("express");
const cors = require("cors");

const app = express();
const PORT = process.env.PORT || 3000;

app.use(cors());
app.use(express.json({ limit: "25mb" }));

// ===============================
// AUTHENTICATION
// ===============================

function authenticate(req, res, next) {
  const serverSecret = process.env.BACKEND_SECRET;

  if (!serverSecret) {
    return res.status(500).json({
      error: "BACKEND_SECRET has not been configured on the server."
    });
  }

  const suppliedSecret = req.headers["x-backend-secret"];

  if (suppliedSecret !== serverSecret) {
    return res.status(401).json({
      error: "Invalid backend secret."
    });
  }

  next();
}

