// ===============================
// RUNWAY VIDEO GENERATION
// ===============================

app.post("/api/video", authenticate, async (req, res) => {
  try {
    const apiKey = getRunwayKey(req);

    if (!apiKey) {
      return res.status(400).json({
        error: "Runway API key is missing."
      });
    }

    const prompt = req.body.prompt || "";
    const image = req.body.image || null;

    if (!prompt.trim()) {
      return res.status(400).json({
        error: "Please provide a video prompt."
      });
    }

    const runwayBody = {
      model: "gen4.5",
      promptText: prompt,
      ratio: "1280:720",
      duration: 5
    };

    // If an image was supplied,
    // Runway will use image-to-video.
    if (image) {
      runwayBody.promptImage = image;
    }

    const response = await fetch(
      "https://api.dev.runwayml.com/v1/image_to_video",
      {
        method: "POST",

        headers: {
          "Content-Type": "application/json",
          "Authorization": `Bearer ${apiKey}`,
          "X-Runway-Version": "2024-11-06"
        },

        body: JSON.stringify(runwayBody)
      }
    );

    const data = await response.json();

    if (!response.ok) {
      return res.status(response.status).json({
        error:
          data.error ||
          data.message ||
          "Runway video request failed."
      });
    }

    res.json(data);

  } catch (error) {
    console.error(error);

    res.status(500).json({
      error: "Video generation failed."
    });
  }
});

