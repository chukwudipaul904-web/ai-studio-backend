// ===============================
// AI APP BUILDER
// ===============================

app.post("/api/app-builder", authenticate, async (req, res) => {
  try {
    const apiKey = getOpenAIKey(req);

    if (!apiKey) {
      return res.status(400).json({
        error: "OpenAI API key is missing."
      });
    }

    const prompt = req.body.prompt || "";

    const instructions = `
You are the AI Studio app builder.

Create a complete standalone mobile-first HTML application.

Rules:

1. Return ONLY HTML.
2. Put HTML, CSS and JavaScript in ONE file.
3. Make it work well on Android phones.
4. Make the design modern and polished.
5. Make buttons actually work.
6. Do not explain the code outside the HTML.
7. Include all features requested by the user.
8. Use localStorage when appropriate.
9. Make the interface responsive.
10. Avoid unnecessary external libraries.

User's requested application:

${prompt}
`;

    const response = await fetch(
      "https://api.openai.com/v1/responses",
      {
        method: "POST",

        headers: {
          "Content-Type": "application/json",
          "Authorization": `Bearer ${apiKey}`
        },

        body: JSON.stringify({
          model: "gpt-6-luna",
          input: instructions
        })
      }
    );

    const data = await response.json();

    if (!response.ok) {
      return res.status(response.status).json({
        error:
          data.error?.message ||
          "AI app builder failed."
      });
    }

    let html = data.output_text || "";

    // Remove markdown code fences if the AI adds them.
    html = html
      .replace(/^```html\s*/i, "")
      .replace(/^```\s*/i, "")
      .replace(/\s*```$/i, "")
      .trim();

    res.json({
      html: html
    });

  } catch (error) {
    console.error(error);

    res.status(500).json({
      error: "AI app builder failed."
    });
  }
});

